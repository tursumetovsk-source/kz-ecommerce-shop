# Database
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/kz_ecommerce?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Storage / S3
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="kz-ecommerce-assets"
S3_REGION="us-east-1"

# Payment Providers
PAYMENT_PROVIDER="HALYK" # HALYK or FREEDOMPAY

# Halyk ePay Config
HALYK_CLIENT_ID="halyk_test_client_id"
HALYK_CLIENT_SECRET="halyk_test_client_secret"
HALYK_PAYMENT_URL="https://testpay.homebank.kz/pay"
HALYK_WEBHOOK_SECRET="halyk_test_webhook_secret"

# FreedomPay Config
FREEDOMPAY_MERCHANT_ID="freedom_test_merchant_id"
FREEDOMPAY_SECRET="freedom_test_secret"
FREEDOMPAY_PAYMENT_URL="https://api.freedompay.kz/payment"

# App Port Configuration
PORT=4000
WEB_URL="http://localhost:3000"
API_URL="http://localhost:4000"
